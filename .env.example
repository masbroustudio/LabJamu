# ============================================================
# LabJamu — Environment Variables Template
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ============================================================

# Perfect Corp / YouCam API (v2.0 — Bearer Token)
YOUCAM_API="your-youcam-bearer-token-here"
YOUCAM_BASE_URL="https://yce-api-01.makeupar.com"
# RSA Public Key (from Perfect Corp dashboard — may be optional in v2.0)
YOUCAM_SECRET="your-rsa-public-key-here"

# NVIDIA NIM — Nemotron 3 Super (via NVIDIA API Catalog)
NIM_KEY="nvapi-your-nim-key-here"
NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NIM_MODEL="nvidia/nemotron-3-super-120b-a12b"

# App Config
VITE_APP_ENV="development"
VITE_APP_VERSION="0.1.0-mvp"
